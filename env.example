# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Your Discord user ID (right-click yourself > Copy User ID, with Developer Mode on)
# Comma-separated if multiple users. Leave empty to allow all users (not recommended).
ALLOWED_USER_IDS=123456789012345678

# Path to agent working directory (defaults to current directory)
AGENT_DIR=/home/youruser/my-agent

# Timeout for Claude Code invocations in milliseconds (default: 120000 = 2 min)
CLAUDE_TIMEOUT_MS=120000
