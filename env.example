# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Your Discord user ID (right-click yourself > Copy User ID, with Developer Mode on)
# Comma-separated if multiple users. Leave empty to allow all users (not recommended).
ALLOWED_USER_IDS=123456789012345678

# Timeout for Claude Code invocations in milliseconds (default: 120000 = 2 min)
CLAUDE_TIMEOUT_MS=120000

# Notion internal integration secret (from https://notion.so/my-integrations).
# Starts with "ntn_". Optional — leave unset to run without Notion. Each page or
# database must be connected to the integration in Notion (page ••• > Connections)
# or Alfred can't see it; sharing is the access boundary, not any code here.
NOTION_TOKEN=your-notion-secret-here

# ── Gmail push (Pub/Sub) ────────────────────────────────────────────────────
# Optional — leave both unset to run without inbound-mail buffering. When set,
# bot.js registers a Gmail watch on your INBOX and pulls change notifications
# from a Pub/Sub subscription, buffering new mail for the next session's digest.
#
# The full topic and subscription names, as `projects/<id>/<kind>/<name>`. The
# service-account key that drains the subscription is NOT configured here — drop
# it at agent/var/google/pubsub-sa.json (gitignored). Setup steps: TODO.md.
#GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-push
#GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/gmail-push-sub

# ── Ronnie (inbound-mail worker) ────────────────────────────────────────────
# Builds on Gmail push above. Ronnie triages each new message (bulk vs personal,
# by header/sender — no model), labels it, and pings you on personal mail. It
# turns on when ANY key below is set; leave them all unset and mail just buffers
# for the digest as before. Ronnie's own broker (its label + calendar-import
# routes) starts in-process with its own token — nothing to configure for it.
#
# Discord webhook Ronnie posts to (Server Settings > Integrations > Webhooks).
# Write-only; carries no bot token.
#RONNIE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/xx/yyy
#
# Gmail label IDs (not names) to apply. Get them from `bin/gmail.js` labels, or
# the API. Unset → Ronnie skips labelling but still pings.
#RONNIE_LABEL_BULK=Label_123
#RONNIE_LABEL_INTERESTING=Label_456
#
# Your own addresses, comma-separated. A DKIM-authenticated forward from one of
# these is the ONLY thing that unlocks the calendar (invite add/remove). Unset →
# the invite path is off; mail is still triaged. Exact match, lower-cased.
#RONNIE_FORWARD_SENDERS=you@gmail.com,you.work@outlook.com
#
# The authserv-id whose DKIM/DMARC verdict is trusted. Default mx.google.com;
# set this only if your mail is on a non-Gmail Workspace domain.
#RONNIE_TRUSTED_AUTHSERV=mx.google.com

# ── Ronnie triage brain (Haiku) ─────────────────────────────────────────────
# Mail the free stages can't place (blocklist/allowlist/list-header grep) goes to
# one Haiku call that returns a label + a one-sentence "why" for the ping. Its
# own API key means the Anthropic Console attributes triage spend to it alone.
# With no key, Ronnie still runs on the free stages (it just can't reason about
# the ambiguous middle). Haiku reads only sender/subject/snippet, never the body.
#ANTHROPIC_API_KEY=sk-ant-...
#RONNIE_HAIKU_MODEL=claude-haiku-4-5-20251001
#
# Senders you've already decided on — checked before any Haiku call. Exact
# address or a bare domain (matches anyone there). Comma-separated.
#RONNIE_BLOCK_SENDERS=community@boyd.org,krispykreme.com   # always file, never ping
#RONNIE_ALLOW_SENDERS=advisor.edu,mom@family.com           # always ping
#
# Cost meter + guard. Rates are USD per MILLION tokens — set them from current
# Haiku pricing so var/ronnie-usage.jsonl estimates match your bill. The daily
# cap stops calling Haiku past that spend (mail is still surfaced, just not
# reasoned about) so a bad day can't run up a charge.
#RONNIE_HAIKU_IN_RATE=1.0
#RONNIE_HAIKU_OUT_RATE=5.0
#RONNIE_HAIKU_DAILY_CAP_USD=0.50

# ── Paths ───────────────────────────────────────────────────────────────────
# Both default correctly from the repo location. Leave them unset unless you
# deliberately relocate Alfred's files — a stale AGENT_DIR pointing at the repo
# root makes the bot silently load no context at all.
#
#   AGENT_DIR   Alfred's config + working dir   (default: <repo>/agent)
#   STATE_DIR   memories, transcripts, logs     (default: <AGENT_DIR>/var)
#
#AGENT_DIR=
#STATE_DIR=
