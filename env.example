# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Your Discord user ID (right-click yourself > Copy User ID, with Developer Mode on)
# Comma-separated if multiple users. Leave empty to allow all users (not recommended).
ALLOWED_USER_IDS=123456789012345678

# Timeout for Claude Code invocations in milliseconds (default: 120000 = 2 min)
CLAUDE_TIMEOUT_MS=120000

# Notion internal integration secret (from https://notion.so/my-integrations).
# Starts with "ntn_". Optional — leave unset to run without Notion. Each page or
# database must be connected to the integration in Notion (page ••• > Connections)
# or Alfred can't see it; sharing is the access boundary, not any code here.
NOTION_TOKEN=your-notion-secret-here

# ── Gmail push (Pub/Sub) ────────────────────────────────────────────────────
# Optional — leave both unset to run without inbound-mail buffering. When set,
# bot.js registers a Gmail watch on your INBOX and pulls change notifications
# from a Pub/Sub subscription, buffering new mail for the next session's digest.
#
# The full topic and subscription names, as `projects/<id>/<kind>/<name>`. The
# service-account key that drains the subscription is NOT configured here — drop
# it at agent/var/google/pubsub-sa.json (gitignored). Setup steps: TODO.md.
#GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-push
#GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/gmail-push-sub

# ── Intervals.icu (training + wellness) ─────────────────────────────────────
# Optional — leave unset to run without Intervals.icu. When set, Alfred can read
# your activities and daily wellness (sleep, HRV, resting HR, readiness). This is
# how Garmin data reaches him: the watch syncs to Garmin Connect, which syncs to
# Intervals.icu, which this reads. Read-only — there is no write path.
#
# Your personal API key, from intervals.icu → Settings → Developer Settings.
#INTERVALS_API_KEY=your-intervals-api-key
#
# Athlete id. Leave unset — "0" means the key's own athlete, which is you. Only
# set it to read a different account the key has access to.
#INTERVALS_ATHLETE_ID=0
#
# Strength load tracking builds on the key above. A nightly pass (added to
# dream.sh) pulls your lifting workouts, decodes the Garmin FIT set records, and
# runs a headless Haiku model to name the exercises and roll up per-muscle load;
# Alfred reads it via the `strength` skill. Nothing extra to configure — it turns
# on with INTERVALS_API_KEY. Data lands in agent/var/strength.db (gitignored).
#
# Optional: a Discord channel whose messages are treated as workout notes (not
# turns for Alfred) — "skipped RDLs today", "shoulder felt off". They're stored
# immutably and feed the interpreter. Unset → no note channel; digest still runs.
#STRENGTH_LOG_CHANNEL=123456789012345678

# ── Ronnie (inbound-mail worker) ────────────────────────────────────────────
# Builds on Gmail push above. New mail is enqueued (ids only) to a durable work
# queue and a consumer triages each: mail Gmail already sorted into Promotions /
# Social (and list-header bulk) is moved to the BULK label and out of the inbox,
# for free; Primary AND Updates mail reaches Haiku (Updates hides bank/sign-in/
# verify notices, so it's worth judging), which returns a label + a one-line "why"
# and pings you on the personal ones. If Haiku is down the queue holds and backs
# off exponentially rather than dropping mail. It
# turns on when ANY key below is set; leave them all unset and mail just buffers
# for the digest as before. Ronnie's own broker (its label + calendar-import
# routes) starts in-process with its own token — nothing to configure for it.
#
# Discord webhook Ronnie posts to (Server Settings > Integrations > Webhooks).
# Write-only; carries no bot token.
#RONNIE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/xx/yyy
#
# ATTENTION is FIVE tiers, and is the label parent:
#   Priority     interrupt now — the ONLY tier that pings; stays in the inbox
#   Interesting  keep + read later — no ping; stays in the inbox
#   Records      receipts, statements, confirmations — no ping; archived
#   General      noise (was "Bulk") — no ping; archived
#   Meetings     appointments and forwarded invites — no ping; archived
# Interesting/General come from these ids (get them from `bin/gmail.js` labels).
# RONNIE_LABEL_BULK is the General label: rename "Bulk" to "General" in Gmail and
# the id stays the same. Priority, Records and Meetings are created by name at
# boot when their id is unset.
#RONNIE_LABEL_INTERESTING=Label_123
#RONNIE_LABEL_BULK=Label_456
#RONNIE_LABEL_PRIORITY=Label_789   # optional; auto-created as "Priority" if unset
#RONNIE_LABEL_RECORDS=Label_790    # optional; auto-created as "Records" if unset
#RONNIE_LABEL_MEETINGS=Label_791   # optional; auto-created as "Meetings" if unset
#
# TOPIC is a child label nested UNDER the attention parent — Priority/Banking,
# Interesting/Banking, Bulk/Banking, etc. Those child labels are resolved (and
# created if missing) by NAME at boot (ronnie/labels.js), so there are no
# per-topic id vars to set. Which topics exist under which tier is TIER_TOPICS
# in ronnie/labels.js (taxes is Interesting/Records only; Meetings has none).
#
# Which senders map to the deterministic topics — exact address, bare domain, or
# any SUBDOMAIN of it (banks mail from mail1.wellsfargo.com, so `wellsfargo.com`
# catches them). An entry starting with `=` matches that exact domain only.
# Comma-separated. Each list has a default in ronnie/topics.js except banking.
# taxes, jobs and ut are BOTH — a domain here plus Haiku for mail from people;
# research, docs and policies are Haiku only.
#RONNIE_TOPIC_ENTROPY_SENDERS=entrpy.co               # default: entrpy.co,entropy.co
#RONNIE_TOPIC_BANKING_SENDERS=wellsfargo.com,chase.com,capitalone.com,americanexpress.com,fidelity.com,marcus.com
#RONNIE_TOPIC_JOBS_SENDERS=ripplematch.com,indeed.com,greenhouse-mail.io,lever.co,myworkday.com   # default: a broader board list
#RONNIE_TOPIC_UT_SENDERS=utees.com,universitytees.com
#RONNIE_TOPIC_HEALTH_SENDERS=prismahealth.org,surveynrc.com
#RONNIE_TOPIC_BENEFITS_SENDERS=surepayroll.com,empower.com,peba.sc.gov,hireright.com   # default: a longer list
#RONNIE_TOPIC_TAXES_SENDERS=freetaxusa.com,taxact.com,irs.gov,1040.com
#RONNIE_TOPIC_RECEIPTS_SENDERS=uber.com,squareup.com,amtrak.com,aa.com
#RONNIE_TOPIC_USC_SENDERS==sc.edu,emails.sc.edu,schc.sc.edu   # never email.sc.edu / mailbox.sc.edu (people)
#
# Your own addresses, comma-separated. A DKIM-authenticated forward from one of
# these is the ONLY thing that unlocks the calendar (invite add/remove). Unset →
# the invite path is off; mail is still triaged. Exact match, lower-cased.
#RONNIE_FORWARD_SENDERS=you@gmail.com,you.work@outlook.com
#
# The authserv-id whose DKIM/DMARC verdict is trusted. Default mx.google.com;
# set this only if your mail is on a non-Gmail Workspace domain.
#RONNIE_TRUSTED_AUTHSERV=mx.google.com

# ── Ronnie triage brain (Haiku) ─────────────────────────────────────────────
# Mail the free stages can't place (blocklist/allowlist/list-header grep) goes to
# one Haiku call that returns a label + a one-sentence "why" for the ping. Ronnie
# runs Haiku the way Alfred runs Claude — `claude -p` over this machine's
# subscription — so there is NO API key to set. Haiku reads the full email; the
# OTP screen runs upstream, so credential mail never reaches it. If claude -p is
# unavailable, classify fails open and Ronnie triages on the free stages alone.
#RONNIE_HAIKU_MODEL=claude-haiku-4-5
#
# Senders you've already decided on — checked before any Haiku call. Exact
# address or a bare domain (matches anyone there). Comma-separated.
#RONNIE_BLOCK_SENDERS=community@boyd.org,krispykreme.com   # always file, never ping
#RONNIE_ALLOW_SENDERS=advisor.edu,mom@family.com           # always ping
#
# Daily cap, counted in CALLS (a subscription has no per-call bill). Past it,
# Ronnie posts a one-time Discord notice and surfaces the rest as personal for the
# day — nothing is dropped. Default 200.
#RONNIE_HAIKU_DAILY_CAP=200
#
# The ToS check (ronnie/policy-check.js, ronnie/policy.js): an email tagged
# `policies` gets an Opus run with WebSearch and an allowlisted WebFetch, and a
# re-check 48 hours later. Only DMARC-passing mail, one run per company per 3
# days, and at most RONNIE_POLICY_DAILY_CAP runs a day (re-checks count).
#RONNIE_POLICY_MODEL=claude-opus-5-5
#RONNIE_POLICY_TIMEOUT_MS=300000
#RONNIE_POLICY_DAILY_CAP=10
# Sender domains whose own pages the check may fetch from this laptop (only when
# DMARC passed). Empty by default: an attacker's domain passes DMARC too, and a
# fetch tells the sender the mailbox is live. Search reads them server-side.
#RONNIE_POLICY_FETCH_DOMAINS=google.com,apple.com
#
# How often the consumer sweeps the queue, in ms (on top of a sweep per Pub/Sub
# nudge). This is what re-probes held mail while Haiku is backing off. Default
# 60000 (60s). A no-op when the queue is empty.
#RONNIE_SWEEP_MS=60000
#
# How many times one message may fail triage (a broken fetch, a failing label
# call — NOT Haiku being down) before it's surfaced as personal and dropped, so a
# single bad message can't wedge the queue. Default 3.
#RONNIE_POISON_CAP=3
#
# The meter logs every call to var/ronnie-usage.jsonl and estimates cost at the
# official Haiku API token rates below ($1 in / $5 out per MILLION tokens). On a
# subscription there is no real bill, so this is the API-equivalent estimate —
# "what these tokens would cost". Override only if the list price changes.
#RONNIE_HAIKU_IN_RATE=1.0
#RONNIE_HAIKU_OUT_RATE=5.0
#
# The "/ronnie-metrics" Discord command renders a self-contained HTML dashboard
# via scripts/ronnie-dashboard.mjs — pure Node, no dependencies, nothing to set.

# ── SMS over Telnyx ─────────────────────────────────────────────────────────
# Optional — leave unset to run without SMS. When set, you can text Alfred and
# he texts back. All four of the first group must be set, or SMS stays off.
#
# Setup, once:
#   1. Telnyx portal: pass identity verification. Add a payment method.
#   2. Buy a toll-free number with SMS. Do NOT pick an 800 number — it costs
#      $500 upfront. 833/844/855/866/877/888 cost $1/month.
#   3. Messaging > Messaging Profiles: create one. Assign the number to it.
#   4. Messaging > Toll-Free Verification: submit the form (sole proprietor).
#      Until it is approved, carriers block texts FROM the number.
#   5. Make the webhook port public with a tunnel. Tailscale Funnel example:
#        tailscale funnel --bg 8788
#      Then set the profile's webhook URL to
#        https://<machine>.<tailnet>.ts.net/telnyx/messaging
#
# API key: portal > Account Settings > API Keys.
#TELNYX_API_KEY=your-telnyx-api-key
# Webhook public key (base64): portal > Account Settings > Keys & Credentials >
# Public Key. The bot rejects any webhook request not signed with it.
#TELNYX_PUBLIC_KEY=base64-public-key
# Alfred's number, E.164.
#TELNYX_PHONE_NUMBER=+18885550100
# The numbers that may text Alfred, comma-separated. The FIRST one is the
# owner: replies typed in the mirror channel go to it. Texts from any other
# number are logged and dropped with no reply.
#SMS_ALLOWED_NUMBERS=+15555550123
#
# Optional. The messaging profile id, sent with each outbound text.
#TELNYX_MESSAGING_PROFILE_ID=
# Optional. A Discord channel that IS the phone thread: each text shows there,
# each reply goes there AND by SMS, and a message typed there is also answered
# by SMS. Unset → SMS only, no Discord copy.
#SMS_MIRROR_CHANNEL=123456789012345678
# Optional. Loopback port for the webhook server. Default 8788.
#SMS_WEBHOOK_PORT=8788

# ── Connection watchdog + restart alerts ────────────────────────────────────
# bot.js watches its Discord gateway and exits non-zero (start-alfred.sh then
# relaunches it) when the connection is unhealthy. Two triggers: it stays down
# past WATCHDOG_GRACE_MS, OR it "flaps" — more than FLAP_MAX reconnects within
# FLAP_WINDOW_MS, which catches a wedged session that keeps half-resuming and so
# reads as up while silently dropping messages. All optional; defaults shown.
#WATCHDOG_GRACE_MS=90000    # down this long (ms) → restart. Default 90s.
#FLAP_WINDOW_MS=180000      # rolling window (ms) for the flap count. Default 3m.
#FLAP_MAX=5                 # more than this many reconnects in the window → restart.
#
# Where restart alerts post. A one-line "⚠️ Alfred restarting — <reason>" webhook
# message, so a restart is visible in seconds. Falls back to RONNIE_DISCORD_WEBHOOK
# when unset; unset both → no alert (the restart still happens).
#ALFRED_ALERT_WEBHOOK=https://discord.com/api/webhooks/xx/yyy

# ── Paths ───────────────────────────────────────────────────────────────────
# Both default correctly from the repo location. Leave them unset unless you
# deliberately relocate Alfred's files — a stale AGENT_DIR pointing at the repo
# root makes the bot silently load no context at all.
#
#   AGENT_DIR   Alfred's config + working dir   (default: <repo>/agent)
#   STATE_DIR   memories, transcripts, logs     (default: <AGENT_DIR>/var)
#
#AGENT_DIR=
#STATE_DIR=
