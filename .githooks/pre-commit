#!/usr/bin/env bash
# Installed by: git config core.hooksPath .githooks
# Lives in the repo (unlike .git/hooks/) so it survives a fresh clone.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# Branch first — it costs nothing and it's pointless to run a suite for a commit
# that shouldn't be made here at all. (Subject checks need the message, so they
# live in commit-msg.)
"$ROOT/scripts/check-commit-hygiene.sh"

# Then secrets — the cheaper of the remaining checks, and the one whose failure
# matters most.
"$ROOT/scripts/check-no-secrets.sh"

# Then the suite. This is here because a commit already slipped through with a
# failing test: `npm test | grep ...` masks the exit code, and the pipeline
# looked like it passed. A hook doesn't care how the command was invoked.
if ! npm test --silent >/tmp/alfred-pretest.$$ 2>&1; then
  echo "❌ Tests failing — commit blocked." >&2
  tail -25 /tmp/alfred-pretest.$$ >&2
  rm -f /tmp/alfred-pretest.$$
  echo >&2
  echo "Bypass only if you know why: git commit --no-verify" >&2
  exit 1
fi
rm -f /tmp/alfred-pretest.$$
echo "✅ Tests pass."
